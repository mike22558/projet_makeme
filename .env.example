# Connexion MySQL : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# Valeur par défaut de XAMPP et WAMP : utilisateur root sans mot de passe.
DATABASE_URL="mysql://root:@127.0.0.1:3306/hotel"

# Secret de signature des sessions Auth.js.
# À générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="remplacer-par-un-secret-aleatoire"
